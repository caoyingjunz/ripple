{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "description": "Ripple 桌面客户端（Electron 壳，React 产物来自 web/dist）",
  "main": "electron/main.js",
  "scripts": {
    "gen:icon": "node tools/gen-icon.js",
    "start": "electron .",
    "dev": "RIPPLE_DEV=1 electron .",
    "smoke": "electron . --smoke",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "dist:mac": "npm run build:web && electron-builder --mac --universal",
    "dist:win": "npm run build:web && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  }
}
